{
  "name": "itworksbetter",
  "version": "1.2.0",
  "private": false,
  "description": "A team of full-stack web developers, graphic designers, and SEO specialists.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamilwyremski/itworksbetter.net"
  },
  "license": "MIT",
  "author": {
    "name": "Kamil Wyremski",
    "email": "kamil@wyremski.pl",
    "url": "https://wyremski.pl/en"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "generate:markdown": "node scripts/generate-markdown-sources.js",
    "prebuild": "npm run generate:markdown",
    "prestart": "npm run generate:markdown",
    "build": "ember build --environment=production && node scripts/inject-head-tags.js",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "ESLINT_USE_FLAT_CONFIG=false eslint . --cache",
    "lint:js:fix": "ESLINT_USE_FLAT_CONFIG=false eslint . --fix",
    "start": "ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\"",
    "test:ember": "ember test"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.13",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.8.0",
    "@ember/test-waiters": "^4.1.2",
    "@glimmer/component": "^2.2.1",
    "@glimmer/tracking": "^1.1.2",
    "concurrently": "^10.0.7",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~7.3.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-fastboot": "^6.0.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-load-initializers": "^3.0.1",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-service-worker": "^9.0.1",
    "ember-source": "^7.4.0",
    "ember-template-lint": "^7.9.4",
    "ember-web-app": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.9.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-qunit": "^8.2.6",
    "loader.js": "^4.7.0",
    "prember": "^2.1.0",
    "prettier": "^3.9.10",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "ember": {
    "edition": "octane"
  },
  "fastbootDependencies": [
    "crypto",
    "node-fetch",
    "url"
  ]
}
